{
  "name": "misconception-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n CLIENT,SERVER -c green,blue \"npm run client\" \"npm run server\"",
    "client": "npm run dev --prefix client",
    "server": "npm run dev --prefix server",
    "seed": "npm run seed --prefix server",
    "bootstrap:teacher": "npm run bootstrap:teacher --prefix server",
    "test": "npm test --prefix server"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
